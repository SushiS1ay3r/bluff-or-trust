import random
from collections import deque, defaultdict
from dataclasses import dataclass

VALUES = [0, 1, 2, 3]
TOTAL_TARGET = 9

@dataclass
class RevealResult:
    was_truth: bool
    actual_value: int
    claimed_value: int

class Deck:
    def __init__(self, seed=None):
        self.cards = [v for v in VALUES for _ in range(4)]
        if seed is not None:
            random.seed(seed)
        random.shuffle(self.cards)
    def draw(self):
        return self.cards.pop() if self.cards else None
    def __len__(self):
        return len(self.cards)

class PlayerBase:
    def __init__(self, name):
        self.name = name
        self.hand = []
        self.bluffs = 1
    def has_cards(self):
        return len(self.hand) > 0
    def give_card(self, v):
        if v is not None:
            self.hand.append(v)
    def use_bluff(self):
        if self.bluffs > 0:
            self.bluffs -= 1
            return True
        return False
    def gain_bluff(self):
        self.bluffs += 1
    def remove_card(self, idx):
        return self.hand.pop(idx)

class Human(PlayerBase):
    def choose_play(self, total):
        print(f"\nYour hand: {sorted(self.hand)} | Your bluffs: {self.bluffs} | Current total: {total}")
        while True:
            m = input("Play index in hand (0..n-1): ").strip()
            if m.isdigit() and int(m) in range(len(self.hand)):
                idx = int(m)
                break
            print("Invalid index.")
        face = "u"
        if self.bluffs > 0:
            face = input("Face-up 'u' or face-down 'd' (bluff): ").strip().lower() or "u"
        if face not in ("u","d"):
            face = "u"
        card = self.remove_card(idx)
        if face == "u":
            return ("up", card, card)
        if not self.use_bluff():
            return ("up", card, card)
        claim_in = input(f"Claim value (0..3) for your face-down card {card}: ").strip()
        claim = int(claim_in) if claim_in.isdigit() and int(claim_in) in VALUES else card
        return ("down", card, claim)

    def decide_on_bluff(self, opponent_claim, total):
        while True:
            x = input(f"Opponent claimed {opponent_claim} face-down. Trust 't' or Bluff 'b'?: ").strip().lower()
            if x in ("t","b"): return x
            print("Type 't' or 'b'.")

    def resolve_keep_or_lose(self, actual, claimed, ctx):
        while True:
            x = input("Choose KEEP 'k' or LOSE 'l' this card's value into the total: ").strip().lower()
            if x in ("k","l"): return x
            print("Type 'k' or 'l'.")

class AdaptiveAI(PlayerBase):
    def __init__(self, name="AI"):
        super().__init__(name)
        self.stats = {
            "claims_true": 1,
            "claims_total": 2,
            "claim_hist": defaultdict(lambda: [1,2]),  # [true_count, total_count]
            "player_face_down_rate": [1,2],
            "player_call_history": {"trust":1,"bluff":1},
            "risk_tolerance": 0.55,
            "call_bias": 0.5
        }

    def post_round_update(self, round_log):
        for e in round_log:
            if e["actor"] == "Human" and e["type"] == "down":
                # record that human played a face-down (increment total count)
                self.stats["player_face_down_rate"][1] += 1
            if e["actor"] == "Human" and e["type"] == "down_reveal":
                self.stats["claims_total"] += 1
                if e["truth"]:
                    self.stats["claims_true"] += 1
                a = self.stats["claim_hist"][e["claim"]]
                a[1] += 1
                if e["truth"]:
                    a[0] += 1

    def p_truth_overall(self):
        return self.stats["claims_true"]/self.stats["claims_total"]

    def p_truth_given_claim(self, claim):
        a = self.stats["claim_hist"][claim]
        return a[0]/a[1]

    def choose_play(self, total):
        safe = [v for v in self.hand if total+v<=TOTAL_TARGET]
        risky = [v for v in self.hand if total+v>TOTAL_TARGET]
        use_bluff = self.bluffs>0 and len(self.hand)>0 and (len(risky)>0 or random.random()<0.15)
        if not use_bluff:
            if safe:
                choice = max(safe) if total<=5 else min(safe)
                self.hand.remove(choice)
                return ("up", choice, choice)
            choice = min(self.hand)
            self.hand.remove(choice)
            return ("up", choice, choice)
        # choose real played card and claim
        real = min(self.hand) if total<=5 else random.choice(self.hand)
        claim = min(real, max(0, TOTAL_TARGET-total-1))
        self.hand.remove(real)
        self.use_bluff()
        return ("down", real, claim)

    def decide_on_bluff(self, opponent_claim, total):
        p_truth = self.p_truth_given_claim(opponent_claim)*0.65 + self.p_truth_overall()*0.35
        expect_total_if_true = total + opponent_claim
        risk = expect_total_if_true/TOTAL_TARGET
        threshold = self.stats["call_bias"] + (risk - self.stats["risk_tolerance"])
        call_bluff_prob = max(0.05, min(0.95, threshold))
        return "b" if random.random()<call_bluff_prob else "t"

    def resolve_keep_or_lose(self, actual, claimed, ctx):
        total = ctx["total"]
        # if caller trusted and claim was true: this path should not be reached (handled separately)
        # For other cases: decide heuristically
        if ctx["called"]=="t":
            x = total
            # choose keep if keeping does not immediately bust and keeps pressure
            return "k" if (x<=TOTAL_TARGET and (TOTAL_TARGET-x)<=1) else "l"
        if ctx["called"]=="b" and ctx["truth"]:
            x = total
            return "k" if (x<=TOTAL_TARGET and (TOTAL_TARGET-x)<=1) else "l"
        if ctx["called"]=="b" and not ctx["truth"]:
            x = total
            return "k" if (x<=TOTAL_TARGET and (TOTAL_TARGET-x)<=1) else "l"

class Game:
    def __init__(self, seed=None, human_first=None):
        self.deck = Deck(seed=seed)
        self.human = Human("Human")
        self.ai = AdaptiveAI("AI")
        self.total = 0
        self.log = []
        for _ in range(4):
            self.human.give_card(self.deck.draw())
            self.ai.give_card(self.deck.draw())
        if human_first is None:
            self.turn = random.choice(["Human","AI"])
        else:
            self.turn = "Human" if human_first else "AI"

    def draw_if_empty_hands(self):
        if not self.human.has_cards() and not self.ai.has_cards():
            # draw one card each if deck has cards
            hcard = self.deck.draw()
            acard = self.deck.draw()
            if hcard is not None:
                self.human.give_card(hcard)
            if acard is not None:
                self.ai.give_card(acard)

    def resolve_after_call(self, actor, opponent, real, claim, call):
        """
        Resolves face-down play according to rules:
        - The card is ADDED to total on reveal first.
        - If caller 't' and truth -> caller gains a bluff and card stays (no keep/lose choice).
        - If caller 't' and false -> card-player (actor) chooses keep/lose.
        - If caller 'b' and truth -> card-player (actor) chooses keep/lose.
        - If caller 'b' and false -> caller (opponent) chooses keep/lose.
        Returns (RevealResult, decision_str) where decision_str is 'k' or 'l' or None when no choice.
        """
        truth = (real == claim)

        # Add card into total immediately on reveal
        self.total += real
        # store reveal in log later by caller
        ctx = {"total": self.total, "called": call, "truth": truth}

        # CASE: caller trusted and was truthful -> award bluff to caller (opponent), no keep/lose
        if call == "t" and truth:
            opponent.gain_bluff()
            # card remains, no choice
            decision = "k"  # treated as kept (no remove)
            return RevealResult(truth, real, claim), decision

        # CASE: caller trusted but was false -> actor chooses keep/lose
        if call == "t" and not truth:
            # actor chooses
            dec = actor.resolve_keep_or_lose(real, claim, ctx)
            if dec == "l":
                # remove card from total (but not below 0)
                self.total = max(0, self.total - real)
            return RevealResult(truth, real, claim), dec

        # CASE: caller accused bluff and it was truth -> actor chooses keep/lose
        if call == "b" and truth:
            dec = actor.resolve_keep_or_lose(real, claim, ctx)
            if dec == "l":
                self.total = max(0, self.total - real)
            return RevealResult(truth, real, claim), dec

        # CASE: caller accused bluff and was correct (false) -> caller chooses keep/lose
        if call == "b" and not truth:
            dec = opponent.resolve_keep_or_lose(real, claim, ctx)
            if dec == "l":
                self.total = max(0, self.total - real)
            return RevealResult(truth, real, claim), dec

        # fallback (shouldn't happen)
        return RevealResult(truth, real, claim), None

    def step(self):
        self.draw_if_empty_hands()
        if self.total > TOTAL_TARGET:
            return True, f"{self.turn} already lost by overflow"
        if not (self.human.has_cards() or self.ai.has_cards()):
            return True, "Stalemate"
        actor = self.human if self.turn == "Human" else self.ai
        opp = self.ai if self.turn == "Human" else self.human

        # actor chooses play
        mode, real, claim = actor.choose_play(self.total)

        if mode == "up":
            # straightforward face-up play: add immediately, check overflow
            self.total += real
            self.log.append({"actor": actor.name, "type": "up", "value": real})
            print(f"{actor.name} played {real} face-up. Total now {self.total}")
            if self.total > TOTAL_TARGET:
                return True, f"{actor.name} loses (exceeded {TOTAL_TARGET})"
            self.turn = opp.name
            return False, None

        # face-down flow
        # log the down play
        self.log.append({"actor": actor.name, "type": "down", "actual": real, "claim": claim})
        print(f"{actor.name} played a card face-down claiming {claim} (actual hidden).")

        # opponent decides
        decision = opp.decide_on_bluff(claim, self.total)
        print(f"{opp.name} decided to {'trust' if decision=='t' else 'call bluff'} the claim.")

        # resolve after call (this will add the card value to total then handle keep/lose logic)
        reveal, decision_keeplose = self.resolve_after_call(actor, opp, real, claim, decision)
        # record reveal log
        self.log.append({
            "actor": actor.name,
            "type": "down_reveal",
            "truth": reveal.was_truth,
            "claim": claim,
            "actual": real,
            "decision": decision_keeplose,
            "caller": opp.name,
            "call": decision
        })

        print(f"Reveal: actual {real} vs claim {claim} -> {'truth' if reveal.was_truth else 'lie'}. Total now {self.total} (after resolution).")

        # check overflow
        if self.total > TOTAL_TARGET:
            return True, f"{actor.name} loses (exceeded {TOTAL_TARGET})"

        # next turn
        self.turn = opp.name
        return False, None

    def play(self):
        while True:
            over, msg = self.step()
            print(f"Total: {self.total}")
            if over:
                print(msg)
                return msg

def play_match(rounds=1, seed=None):
    ai = AdaptiveAI()
    human_score = 0
    ai_score = 0
    for r in range(1, rounds+1):
        g = Game(seed=seed+r if seed is not None else None)
        g.ai = ai
        g.human = Human("Human")
        g.total = 0
        g.turn = random.choice(["Human","AI"])
        # initial deal (4 each)
        g.human.hand = []
        g.ai.hand = []
        for _ in range(4):
            g.human.give_card(g.deck.draw())
            g.ai.give_card(g.deck.draw())
        print(f"\n=== Round {r} === | First: {g.turn}")
        result = g.play()
        ai.post_round_update(g.log)
        if "AI loses" in result:
            human_score += 1
        elif "Human loses" in result:
            ai_score += 1
        print(f"Score -> You {human_score} : AI {ai_score}")
    print("\nFinal:", "You win" if human_score>ai_score else ("AI wins" if ai_score>human_score else "Draw"))

if __name__ == "__main__":
    play_match(rounds=1, seed=42)
